#!/usr/bin/env bash
set -euo pipefail

MODULE_NAME='goodix_5125_hugepage'
MODULE_PRIORITY='400'
POLICY='(dontaudit fprintd_t sysctl_vm_t (file (read)))'

usage() {
    cat <<'USAGE'
Usage: sudo ./tools/goodix-selinux-hugepages <enable|disable|status>

  enable   Install the reviewed optional SELinux dontaudit rule.
  disable  Remove only that module and restore stock SELinux audit behavior.
  status   Show whether the module is installed.

The rule never grants access. It only suppresses denied reads matching:
  fprintd_t -> sysctl_vm_t : file read
USAGE
}

need_tools() {
    command -v semodule >/dev/null || { echo 'STOP: semodule not found' >&2; exit 3; }
    command -v getenforce >/dev/null || { echo 'STOP: getenforce not found' >&2; exit 3; }
}

need_root() {
    if [[ ${EUID} -ne 0 ]]; then
        printf 'STOP: run with sudo: sudo %q %s\n' "$0" "$1" >&2
        exit 2
    fi
}

module_lines() {
    LC_ALL=C semodule -lfull | awk -v name="$MODULE_NAME" '$2 == name {print}'
}

module_state() {
    local lines="$1"
    if [[ -z "$lines" ]]; then
        return 1
    fi
    if awk -v p="$MODULE_PRIORITY" -v n="$MODULE_NAME" '$1 == p && $2 == n {ok++} END {exit !(ok == 1)}' <<<"$lines" &&
       [[ "$(wc -l <<<"$lines")" -eq 1 ]]; then
        return 0
    fi
    return 2
}

case "${1:-}" in
    enable)
        need_root enable
        need_tools
        [[ "$(getenforce)" == 'Enforcing' ]] || { echo 'STOP: SELinux Enforcing is required' >&2; exit 4; }
        lines="$(module_lines)"
        if module_state "$lines"; then
            echo 'GOODIX_SELINUX_HUGEPAGE_SUPPRESSION=ALREADY_ENABLED'
            exit 0
        else
            state=$?
            if [[ $state -eq 2 ]]; then
                printf 'STOP: module name collision or unexpected priority:\n%s\n' "$lines" >&2
                exit 6
            fi
        fi

        umask 077
        tmpdir="$(mktemp -d -t goodix-selinux.XXXXXX)"
        trap 'rm -rf -- "$tmpdir"' EXIT
        policy_file="$tmpdir/${MODULE_NAME}.cil"
        printf '%s\n' "$POLICY" > "$policy_file"

        semodule -X "$MODULE_PRIORITY" -i "$policy_file"
        lines="$(module_lines)"
        if ! module_state "$lines"; then
            echo 'STOP: module installation could not be verified' >&2
            exit 7
        fi
        echo 'GOODIX_SELINUX_HUGEPAGE_SUPPRESSION=ENABLED'
        echo 'SELINUX_ACCESS_GRANTED=false'
        echo 'SUPPRESSED_TUPLE=fprintd_t->sysctl_vm_t:file:read'
        ;;

    disable|restore)
        need_root disable
        need_tools
        lines="$(module_lines)"
        if [[ -z "$lines" ]]; then
            echo 'GOODIX_SELINUX_HUGEPAGE_SUPPRESSION=ALREADY_DISABLED'
            exit 0
        fi
        if ! module_state "$lines"; then
            printf 'STOP: module name collision or unexpected priority; nothing removed:\n%s\n' "$lines" >&2
            exit 6
        fi
        semodule -X "$MODULE_PRIORITY" -r "$MODULE_NAME"
        lines="$(module_lines)"
        if [[ -n "$lines" ]]; then
            printf 'STOP: module remains after removal:\n%s\n' "$lines" >&2
            exit 8
        fi
        echo 'GOODIX_SELINUX_HUGEPAGE_SUPPRESSION=DISABLED'
        echo 'SELINUX_STOCK_AUDIT_BEHAVIOR=RESTORED'
        ;;

    status)
        need_tools
        lines="$(module_lines)"
        if [[ -z "$lines" ]]; then
            echo 'GOODIX_SELINUX_HUGEPAGE_SUPPRESSION=DISABLED'
            exit 0
        fi
        printf '%s\n' "$lines"
        if module_state "$lines"; then
            echo 'GOODIX_SELINUX_HUGEPAGE_SUPPRESSION=ENABLED'
            exit 0
        fi
        echo 'GOODIX_SELINUX_HUGEPAGE_SUPPRESSION=FOREIGN_OR_UNEXPECTED_PRIORITY' >&2
        exit 6
        ;;

    -h|--help|'')
        usage
        ;;

    *)
        usage >&2
        exit 2
        ;;
esac
