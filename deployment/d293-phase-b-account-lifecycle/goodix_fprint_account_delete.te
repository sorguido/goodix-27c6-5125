# SPDX-License-Identifier: GPL-2.0-or-later
module goodix_fprint_account_delete 1.0;

require {
    type useradd_t;
    type fprintd_var_lib_t;
    attribute file_type;
    class file { execute execute_no_trans getattr open read };
    class dir { getattr open read search };
    class lnk_file getattr;
}

type goodix_fprint_account_delete_exec_t;
typeattribute goodix_fprint_account_delete_exec_t file_type;

# Execute only the dedicated account-delete hook, without a domain transition.
allow useradd_t goodix_fprint_account_delete_exec_t:file {
    execute execute_no_trans getattr open read
};

# Inspect names and metadata only; never read or modify fingerprint contents.
allow useradd_t fprintd_var_lib_t:dir { getattr open read search };
allow useradd_t fprintd_var_lib_t:file getattr;
allow useradd_t fprintd_var_lib_t:lnk_file getattr;
