#!/usr/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
set -euo pipefail

runtime=/usr/lib64/goodix-27c6-5125/current
daemon=/usr/libexec/fprintd
material=/var/lib/goodix-5125-poc
required_material=(target-material-manifest.json transport-material.bin target-config-90.bin gfusb.dll fdt-cache.bin)
fail() { printf 'GOODIX_MANAGED_RUNTIME=FAIL reason=%s\n' "$1" >&2; exit 126; }

[[ $EUID -eq 0 ]] || fail daemon_must_run_as_root
[[ -L $runtime ]] || fail runtime_link_invalid
resolved=$(readlink -f -- "$runtime")
[[ $resolved == /usr/lib64/goodix-27c6-5125/[0-9a-f]* && -d $resolved && ! -L $resolved ]] ||
  fail runtime_target_invalid
[[ -x $daemon && -f $daemon && ! -L $daemon ]] || fail fprintd_daemon_invalid
for library in libfprint-2.so.2.0.0 libgusb.so.2 libopencv_core.so.413 \
  libopencv_features2d.so.413 libopencv_flann.so.413 libopencv_imgproc.so.413; do
  [[ -f $resolved/$library && ! -L $resolved/$library ]] || fail "runtime_${library}_invalid"
done
[[ -d $material && ! -L $material && $(stat -c '%u:%g:%a' "$material") == 0:0:700 ]] ||
  fail material_directory_metadata_invalid
for name in "${required_material[@]}"; do
  path=$material/$name
  [[ -f $path && ! -L $path && $(stat -c '%u:%g:%a' "$path") == 0:0:600 ]] ||
    fail "material_${name}_metadata_invalid"
done

exec env LD_LIBRARY_PATH="$resolved" FP_DRIVERS_ALLOWLIST=goodix_27c6_5125 "$daemon"
