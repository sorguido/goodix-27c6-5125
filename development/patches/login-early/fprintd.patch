--- /dev/null
+++ b/src/login-preparation.inc
@@ -0,0 +1,156 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Private login extension, paired with the Goodix driver in this candidate.
+ * One greeter bus owner, one preparation, one explicit ClaimLogin/VerifyStart.
+ */
+static void login_close (FprintDevice *rdev);
+
+static gboolean
+login_close_idle (gpointer data)
+{
+  login_close (data);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+login_schedule_close (FprintDevice *rdev)
+{
+  g_idle_add_full (G_PRIORITY_DEFAULT, login_close_idle,
+                   g_object_ref (rdev), g_object_unref);
+}
+
+static void
+login_complete (FprintDevice *rdev, gboolean ready, const char *reason)
+{
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+  priv->login_ready = ready && priv->login_owner != NULL;
+  g_message ("GOODIX_LOGIN_PREPARATION ready=%d reason=%s", priv->login_ready, reason);
+  if (priv->login_invocation)
+    {
+      g_dbus_method_invocation_return_value (priv->login_invocation,
+                                              g_variant_new ("(b)", priv->login_ready));
+      g_clear_object (&priv->login_invocation);
+    }
+  if (!priv->login_ready)
+    login_schedule_close (rdev);
+}
+
+static void
+login_prepared (FpDevice *dev, gboolean ready, const char *reason, FprintDevice *rdev)
+{
+  login_complete (rdev, ready, reason);
+}
+
+static void
+login_suspend_after_close (FprintDevice *rdev)
+{
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+  if (priv->login_suspend_task)
+    fp_device_suspend (priv->dev, NULL, suspend_cb,
+                        g_steal_pointer (&priv->login_suspend_task));
+}
+
+static void
+login_closed (GObject *dev, GAsyncResult *res, gpointer data)
+{
+  g_autoptr(FprintDevice) rdev = data;
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+  g_autoptr(GError) error = NULL;
+  if (!fp_device_close_finish (FP_DEVICE (dev), res, &error))
+    g_warning ("Goodix login close: %s", error->message);
+  priv->current_action = ACTION_NONE;
+  login_suspend_after_close (rdev);
+}
+
+static void
+login_close (FprintDevice *rdev)
+{
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+  /* A transferred claim is released by its PAM owner, including cancellation.
+   * The driver already fences/cancels RX on pre-Verify invalidation. */
+  if (priv->_session || priv->current_action != ACTION_NONE)
+    return;
+  if (!fp_device_is_open (priv->dev))
+    {
+      login_suspend_after_close (rdev);
+      return;
+    }
+  priv->current_action = ACTION_CLOSE;
+  fp_device_close (priv->dev, NULL, login_closed, g_object_ref (rdev));
+}
+
+static void
+login_opened (GObject *dev, GAsyncResult *res, gpointer data)
+{
+  g_autoptr(FprintDevice) rdev = data;
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+  g_autoptr(GError) error = NULL;
+  gboolean started = FALSE;
+  priv->current_action = ACTION_NONE;
+  if (!fp_device_open_finish (FP_DEVICE (dev), res, &error))
+    {
+      login_complete (rdev, FALSE, error->message);
+      return;
+    }
+  if (priv->login_owner)
+    g_signal_emit_by_name (dev, "goodix-login-prepare", &started);
+  if (!started)
+    login_complete (rdev, FALSE, "preparation not started; password required");
+}
+
+static gboolean
+login_prepare (FprintDBusDevice *dbus_dev, GDBusMethodInvocation *invocation)
+{
+  FprintDevice *rdev = FPRINT_DEVICE (dbus_dev);
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+  if (priv->_session || priv->login_owner || priv->current_action != ACTION_NONE ||
+      fp_device_is_open (priv->dev) ||
+      !g_signal_lookup ("goodix-login-prepare", G_OBJECT_TYPE (priv->dev)))
+    {
+      g_dbus_method_invocation_return_value (invocation, g_variant_new ("(b)", FALSE));
+      return TRUE;
+    }
+  priv->login_owner = g_strdup (g_dbus_method_invocation_get_sender (invocation));
+  priv->login_claim = FALSE;
+  priv->login_used = FALSE;
+  priv->login_invocation = g_object_ref (invocation);
+  _fprint_device_add_client (rdev, priv->login_owner);
+  if (!priv->login_signal)
+    priv->login_signal = g_signal_connect_object (priv->dev, "goodix-login-prepared",
+                                                  G_CALLBACK (login_prepared), rdev, 0);
+  priv->current_action = ACTION_OPEN;
+  fp_device_open (priv->dev, NULL, login_opened, g_object_ref (rdev));
+  return TRUE;
+}
+
+static gboolean
+login_authorized (GDBusMethodInvocation *invocation, gboolean preparing)
+{
+  GDBusConnection *connection = g_dbus_method_invocation_get_connection (invocation);
+  g_autoptr(GVariant) ret = g_dbus_connection_call_sync (
+    connection, "org.freedesktop.DBus", "/org/freedesktop/DBus",
+    "org.freedesktop.DBus", "GetConnectionUnixUser",
+    g_variant_new ("(s)", g_dbus_method_invocation_get_sender (invocation)),
+    G_VARIANT_TYPE ("(u)"), G_DBUS_CALL_FLAGS_NONE, 1000, NULL, NULL);
+  guint32 uid;
+  struct passwd record, *found = NULL;
+  char buffer[16384];
+  if (!ret)
+    return FALSE;
+  g_variant_get (ret, "(u)", &uid);
+  if (!preparing)
+    return uid == 0; /* ClaimLogin is the root display-manager PAM worker. */
+  return getpwnam_r ("plasmalogin", &record, buffer, sizeof buffer, &found) == 0 &&
+         found != NULL && record.pw_uid == uid;
+}
+
+void
+fprint_device_login_removed (FprintDevice *rdev)
+{
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+  if (priv->login_owner)
+    {
+      if (priv->login_claim && priv->current_cancellable)
+        g_cancellable_cancel (priv->current_cancellable);
+      login_complete (rdev, FALSE, "device removed; password required");
+    }
+}
