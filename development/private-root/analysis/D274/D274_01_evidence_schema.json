{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "D274_01_evidence_schema.json",
  "title": "D274 sanitized Windows OEM multiframe evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capture_sha256", "target_vid", "target_pid", "firmware_identity_status",
    "workflow_class", "first_cycle_status", "first_image_b0_frame",
    "first_0x34_frame", "first_irq0200_frame", "post_up_0x20_frame",
    "post_up_b0_frame", "post_up_0x50_frame", "post_0x50_nav_frame",
    "rearm_0x32_frame", "second_irq2_frame", "second_0x22_frame",
    "second_0x22_ack_frame", "second_b0_frame", "second_cycle_target_observed",
    "third_cycle_observed", "timing_observations_ms", "host_deadline_policy",
    "device_timeout_claim", "privacy_payload_exported",
    "biometric_plaintext_exported", "secret_material_exported", "result_class",
    "failure_class"
  ],
  "properties": {
    "capture_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "target_vid": {"const": "27c6"},
    "target_pid": {"const": "5125"},
    "firmware_identity_status": {"type": "string"},
    "workflow_class": {"type": "string"},
    "first_cycle_status": {"enum": ["OBSERVED_COMPLETE", "NOT_OBSERVED_COMPLETE"]},
    "first_image_b0_frame": {"$ref": "#/$defs/frameOrNull"},
    "first_0x34_frame": {"$ref": "#/$defs/frameOrNull"},
    "first_irq0200_frame": {"$ref": "#/$defs/frameOrNull"},
    "post_up_0x20_frame": {"$ref": "#/$defs/frameOrNull"},
    "post_up_b0_frame": {"$ref": "#/$defs/frameOrNull"},
    "post_up_0x50_frame": {"$ref": "#/$defs/frameOrNull"},
    "post_0x50_nav_frame": {"$ref": "#/$defs/frameOrNull"},
    "rearm_0x32_frame": {"$ref": "#/$defs/frameOrNull"},
    "second_irq2_frame": {"$ref": "#/$defs/frameOrNull"},
    "second_0x22_frame": {"$ref": "#/$defs/frameOrNull"},
    "second_0x22_ack_frame": {"$ref": "#/$defs/frameOrNull"},
    "second_b0_frame": {"$ref": "#/$defs/frameOrNull"},
    "second_cycle_target_observed": {"type": "boolean"},
    "third_cycle_observed": {"type": "boolean"},
    "timing_observations_ms": {"type": "object", "additionalProperties": {"type": "number"}},
    "host_deadline_policy": {"const": "EVIDENCE_BOUNDED_NOT_DEVICE_TIMEOUT_CLAIM"},
    "device_timeout_claim": {"const": "UNKNOWN"},
    "privacy_payload_exported": {"const": false},
    "biometric_plaintext_exported": {"const": false},
    "secret_material_exported": {"const": false},
    "result_class": {"enum": ["TARGET_CAPTURE_OBSERVED", "STATICALLY_VERIFIED_OEM", "STRONG_CAUSAL_INFERENCE", "INFERRED", "THIRD_PARTY_CORROBORATION", "OPERATOR_MARKER_ONLY", "UNKNOWN", "SYNTHETIC_FIXTURE_PASS"]},
    "failure_class": {"type": ["string", "null"]}
  },
  "$defs": {
    "frameMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame", "direction", "outer_wrapper", "physical_length",
        "declared_outer_length", "relative_timestamp_ms"
      ],
      "properties": {
        "frame": {"type": "integer"},
        "direction": {"enum": ["host_to_device", "device_to_host"]},
        "outer_wrapper": {"type": "string", "pattern": "^0x[0-9a-f]{2}$"},
        "physical_length": {"type": "integer"},
        "declared_outer_length": {"type": "integer"},
        "relative_timestamp_ms": {"type": "number"},
        "declared_b0_length": {"type": "integer"},
        "tls_record_type_class": {"enum": ["TLS_APPLICATION_DATA", "UNKNOWN"]},
        "cycle_association": {
          "enum": ["FIRST_CYCLE_FINGERPRINT", "FIRST_CYCLE_POST_UP",
                   "SECOND_CYCLE_FINGERPRINT"]
        }
      }
    },
    "frameOrNull": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/frameMetadata"}]}
  }
}
