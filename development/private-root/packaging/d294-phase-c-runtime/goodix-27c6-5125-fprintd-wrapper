#!/usr/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
set -euo pipefail

runtime=/usr/lib64/goodix-27c6-5125
daemon=/usr/libexec/fprintd
material=/var/lib/goodix-5125-poc
required_material=(
  target-material-manifest.json
  transport-material.bin
  target-config-90.bin
  gfusb.dll
  fdt-cache.bin
)

fail() {
  printf 'GOODIX_PHASE_C_RUNTIME=FAIL reason=%s\n' "$1" >&2
  exit 126
}

[[ $EUID -eq 0 ]] || fail daemon_must_run_as_root
[[ -d $runtime && ! -L $runtime ]] || fail runtime_directory_invalid
[[ -f $runtime/libfprint-2.so.2.0.0 && ! -L $runtime/libfprint-2.so.2.0.0 ]] ||
  fail runtime_library_invalid
[[ -L $runtime/libfprint-2.so.2 &&
   $(readlink "$runtime/libfprint-2.so.2") == libfprint-2.so.2.0.0 ]] ||
  fail runtime_soname_link_invalid
[[ -L $runtime/libfprint-2.so &&
   $(readlink "$runtime/libfprint-2.so") == libfprint-2.so.2 ]] ||
  fail runtime_link_invalid
[[ -x $daemon && -f $daemon && ! -L $daemon ]] || fail fprintd_daemon_invalid
[[ -d $material && ! -L $material ]] || fail material_directory_invalid
[[ $(stat -c '%u:%g:%a' "$material") == 0:0:700 ]] ||
  fail material_directory_metadata_invalid
for name in "${required_material[@]}"; do
  path=$material/$name
  [[ -f $path && ! -L $path ]] || fail "material_${name}_invalid"
  [[ $(stat -c '%u:%g:%a' "$path") == 0:0:600 ]] ||
    fail "material_${name}_metadata_invalid"
done

exec env LD_LIBRARY_PATH="$runtime" \
  FP_DRIVERS_ALLOWLIST=goodix_27c6_5125 "$daemon"
